DOMAIN=dominio.com
EMAIL=email@email.com

# credenciais para acessar a tela de transmissao (host)
# lista de usuarios no formato usuario1:"senha1",usuario2:"senha2"
# aspas simples envolvendo tudo + aspas duplas em cada senha evitam que
# caracteres como # sejam tratados como comentario pelo dotenv
AUTH_USERS='usuario1:"senha1",usuario2:"senha2"'
# string aleatoria usada para assinar o cookie de sessao (ex.: openssl rand -hex 32)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
